# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending emails via Resend (contact forms, etc.).
# Obtain your key from https://resend.com and add it to your environment secrets.
RESEND_API_KEY="MY_RESEND_API_KEY"

# Firebase configuration — these are public identifiers for client-side use.
# See: https://firebase.google.com/docs/web/setup
VITE_FIREBASE_API_KEY="AIzaSyCpqyCDacaNWNVfJd4YdWKpmQj9OSTLzSw"
VITE_FIREBASE_AUTH_DOMAIN="infosys-hrms-prod-87249.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="infosys-hrms-prod-87249"
VITE_FIREBASE_STORAGE_BUCKET="infosys-hrms-prod-87249.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="675107231678"
VITE_FIREBASE_APP_ID="1:675107231678:web:bbf30f8f9c5f6634610bef"
