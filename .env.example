# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending emails via Resend (contact forms, etc.).
# Obtain your key from https://resend.com and add it to your environment secrets.
RESEND_API_KEY="MY_RESEND_API_KEY"

# Firebase configuration — these are public identifiers for client-side use.
# See: https://firebase.google.com/docs/web/setup
VITE_FIREBASE_API_KEY="AIzaSyCEeW_tLz0Jwpzdf-CMQBGPZUubXxU4Ejk"
VITE_FIREBASE_AUTH_DOMAIN="aion-ims.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="aion-ims"
VITE_FIREBASE_STORAGE_BUCKET="aion-ims.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="104721340823"
VITE_FIREBASE_APP_ID="1:104721340823:web:8ebdf90580bbeaf80fccd2"

# Web3Forms Access Key — Required for frontend-only form submissions (Admissions).
# Sign up at https://web3forms.com and create a form to get your free Access Key.
# Set this in your Firebase environment: firebase functions:config WEB3FORMS access_key="YOUR_KEY"
# Or set it as a Vite env var in your .env file:
VITE_WEB3FORMS_ACCESS_KEY="YOUR_WEB3FORMS_ACCESS_KEY"
